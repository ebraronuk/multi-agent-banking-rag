# --- LLM provider -----------------------------------------------------------
# Pick one. If the matching key is empty, the app falls back to FakeChatModel
# (deterministic canned responses) so the API and tests still run offline.
LLM_PROVIDER=anthropic             # anthropic | openai | google | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=                    # Google AI Studio free-tier key (aistudio.google.com/apikey)
# Model name must match LLM_PROVIDER: claude-sonnet-5 (anthropic) | gpt-4o-mini (openai)
# | gemini-2.0-flash (google, free-tier friendly)
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---------------------------------------------------------
EMBEDDING_PROVIDER=fake           # openai | fake (hash-based, offline-safe)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---------------------------------------------------------
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION=banking_kb

# --- MCP tool server --------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- Conversation memory ---------------------------------------------------
# Empty = in-process dict fallback (fine for local dev/tests, lost on restart,
# not shared across replicas). docker-compose sets this to the redis service.
REDIS_URL=
CONVERSATION_HISTORY_LIMIT=6
CONVERSATION_TTL_SECONDS=86400

# --- App ---------------------------------------------------------------
APP_ENV=local                     # local | staging | production
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT=20/minute         # slowapi limit string, per-IP on POST /chat
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; the frontend's origin(s)

# --- Observability (optional, off by default) --------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
