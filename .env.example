# --- LLM sağlayıcı -----------------------------------------------------------
# Birini seç. Karşılık gelen anahtar boşsa uygulama FakeChatModel'e düşer
# (deterministik, hazır cevaplar) — API ve testler yine offline çalışır.
LLM_PROVIDER=anthropic             # anthropic | openai | google | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=                    # Google AI Studio ücretsiz katman anahtarı (aistudio.google.com/apikey)
# Model adı LLM_PROVIDER ile eşleşmeli: claude-sonnet-5 (anthropic) | gpt-4o-mini (openai)
# | gemini-flash-latest (google — sabit bir sürüm adı yerine bilinçli olarak bu alias:
# gemini-2.0-flash bazı projelerde ücretsiz katmanda "limit: 0" hatası veriyor, gemini-2.5-flash
# de bazı (yeni) hesaplarda "no longer available to new users" 404'ü veriyor — ikisi de canlı
# doğrulandı. "-latest" alias'ı Google'ın güncel önerilen modele yönlendirmesi, aynı kırılma
# tekrar olduğunda LLM_MODEL'i elle güncellemeye gerek kalmıyor)
LLM_MODEL=claude-sonnet-5

# --- Embedding'ler ---------------------------------------------------------
EMBEDDING_PROVIDER=fake           # openai | fake (hash-tabanlı, offline-güvenli)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vektör deposu ---------------------------------------------------------
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION=banking_kb

# --- MCP araç sunucusu --------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
# true = ayrı bir MCP süreci olmayan tek-konteynerli bir dağıtımda (ör. Render)
# gerçek bir LLM sağlayıcısıyla da in-process araç istemcisi kullan.
FORCE_IN_PROCESS_TOOLS=false

# --- Konuşma hafızası ---------------------------------------------------------
# Boş = in-process dict fallback (lokal geliştirme/testler için sorun değil,
# restart'ta kaybolur, replikalar arası paylaşılmaz). docker-compose bunu
# redis servisine set ediyor.
REDIS_URL=
CONVERSATION_HISTORY_LIMIT=6
CONVERSATION_TTL_SECONDS=86400

# --- Bankacılık verisi (accounts/cards/transactions) -----------------------------
# Boş = in-process fixture dict fallback (lokal geliştirme/testler için sorun
# değil, restart'ta sıfırlanır, gerçek SQL yok). docker-compose bunu postgres
# servisine set ediyor; şema + seed verisi db/schema.sql'de yaşıyor (Docker
# tarafından otomatik uygulanır, ya da Docker'sız lokal kullanım için
# `python scripts/seed_postgres.py` ile).
DATABASE_URL=

# --- Uygulama ---------------------------------------------------------------
APP_ENV=local                     # local | staging | production
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT=20/minute         # slowapi limit string, POST /chat üzerinde IP başına
CORS_ALLOWED_ORIGINS=http://localhost:3000   # virgülle ayrılmış; frontend'in origin(leri)

# --- Gözlemlenebilirlik (opsiyonel, varsayılan kapalı) --------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
