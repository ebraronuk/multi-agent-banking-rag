# --- LLM provider -----------------------------------------------------------
# Pick one. If neither key is set, the app falls back to FakeLLMClient
# (deterministic canned responses) so the API and tests still run offline.
LLM_PROVIDER=anthropic            # anthropic | openai | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---------------------------------------------------------
EMBEDDING_PROVIDER=fake           # openai | fake (hash-based, offline-safe)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---------------------------------------------------------
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION=banking_kb

# --- MCP tool server --------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- App ---------------------------------------------------------------
APP_ENV=local                     # local | staging | production
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT=20/minute         # slowapi limit string, per-IP on POST /chat

# --- Observability (optional, off by default) --------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
